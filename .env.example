# Kopieer dit bestand naar .env en vul de waarden in

# Admin toegangstoken (verander dit naar iets unieks!)
ADMIN_TOKEN=verander_dit_naar_een_sterk_wachtwoord

# Server poort
PORT=3000

# Email instellingen (optioneel - voor bevestigingsmails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=jouw@email.nl
SMTP_PASS=jouw_app_wachtwoord
EMAIL_FROM=noreply@groepenkastenservice.nl
EMAIL_TO=jouw@email.nl

# Bedrijfsinfo
COMPANY_NAME=Groepenkastenservice Maassluis
COMPANY_PHONE=06-12345678
COMPANY_KVK=12345678
